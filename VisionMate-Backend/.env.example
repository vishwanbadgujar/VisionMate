# VisionMate Backend Environment Template

# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# CORS Configuration
# Set to your frontend URL in production
CORS_ORIGIN=http://localhost:8443

# Vision Provider
# Options: mock, google, anthropic
VISION_PROVIDER=mock

# ============================================
# Google Cloud Vision Configuration
# ============================================
# Only needed if VISION_PROVIDER=google
# GOOGLE_VISION_API_KEY=your_api_key_here
# GOOGLE_PROJECT_ID=your_project_id_here

# ============================================
# Anthropic Claude Configuration
# ============================================
# Only needed if VISION_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_api_key_here

# ============================================
# Security & Rate Limiting
# ============================================
# API_KEY_REQUIRED=false
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Database (for future use)
# ============================================
# DATABASE_URL=sqlite://./visionmate.db
